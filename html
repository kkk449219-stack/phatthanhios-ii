<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VIP SYSTEM PANEL - GAME ASSIST</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    overflow-x: hidden;
    background: radial-gradient(circle at 50% 50%, #11111d 0%, #05050a 60%, #000 100%);
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: white;
    user-select: none;
    -webkit-user-select: none;
}

/* Các vòng tròn trang trí bay nền */
.circle {
    position: fixed;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: radial-gradient(circle, rgba(255,255,255,0.03) 0%, rgba(0,0,0,0) 70%);
    animation: float 8s ease-in-out infinite;
    pointer-events: none;
}

.c1 { width: 220px; height: 220px; left: 5%; top: 10%; }
.c2 { width: 300px; height: 300px; right: -60px; top: 15%; animation-delay: 1.5s; }
.c3 { width: 160px; height: 160px; left: 15%; bottom: -40px; animation-delay: 3s; }
.c4 { width: 250px; height: 250px; right: 10%; bottom: -80px; animation-delay: 4.5s; }

@keyframes float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(30px, -40px) rotate(180deg); }
}

.container {
    position: relative;
    z-index: 5;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 25px 15px;
}

/* MÀN HÌNH KHÓA NHẬP KEY */
.key-screen {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9999;
    background: rgba(5, 5, 10, 0.95);
    backdrop-filter: blur(20px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.key-card {
    width: min(380px, 90vw);
    padding: 35px 25px;
    background: rgba(15, 15, 25, 0.9);
    border: 1px solid rgba(0, 240, 255, 0.3);
    border-radius: 24px;
    text-align: center;
    box-shadow: 0 0 30px rgba(0, 240, 255, 0.2);
}

.key-input {
    width: 100%;
    height: 50px;
    background: #090910;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    padding: 0 15px;
    color: #00ffd5;
    font-size: 16px;
    text-align: center;
    font-weight: bold;
    letter-spacing: 2px;
    outline: none;
    margin: 20px 0 10px 0;
    transition: 0.3s;
}

.key-input:focus {
    border-color: #00ffd5;
    box-shadow: 0 0 15px rgba(0, 255, 213, 0.3);
}

.key-submit-btn {
    width: 100%;
    height: 48px;
    background: linear-gradient(45deg, #00f0ff, #00ff87);
    border: none;
    border-radius: 12px;
    color: #000;
    font-weight: 900;
    font-size: 15px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}

.key-submit-btn:active { transform: scale(0.97); }

.key-error {
    color: #ff3366;
    font-size: 13px;
    margin-top: 10px;
    font-weight: bold;
    min-height: 18px;
}

/* Bảng Điều Khiển Glassmorphism */
.panel {
    width: min(440px, 94vw);
    padding: 35px 24px;
    text-align: center;
    border-radius: 28px;
    background: rgba(15, 15, 25, 0.8);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.9),
                inset 0 0 20px rgba(255, 255, 255, 0.05);
}

.logo {
    font-size: 28px;
    font-weight: 900;
    letter-spacing: 5px;
    background: linear-gradient(45deg, #ff007f, #00f0ff, #00ff87);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 6px;
    text-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
}

.sub {
    color: #8a8a9e;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 3px;
    margin-bottom: 25px;
    text-transform: uppercase;
}

/* Viền Cầu Vồng 7 Màu */
.rainbow-box {
    position: relative;
    border-radius: 16px;
    padding: 2px;
    background: linear-gradient(90deg, #ff0000, #ff7300, #fffb00, #48ff00, #00ffd5, #002bfd, #7a00ff, #ff00c8, #ff0000);
    background-size: 400% 400%;
    animation: rainbowAnimation 5s linear infinite;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.1);
}

@keyframes rainbowAnimation {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.rainbow-btn {
    width: 100%;
    height: 52px;
    border: none;
    border-radius: 14px;
    background: #0d0d14;
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    letter-spacing: 1.5px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    transition: all 0.2s ease;
}

.rainbow-btn:hover { background: #151522; }
.rainbow-btn:active { transform: scale(0.97); }

.featureGrid {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.statusBadge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    background: rgba(255, 255, 255, 0.08);
    color: #888;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: 0.3s;
}

/* Trạng thái BẬT (ON) */
.active-rainbow {
    animation: rainbowAnimation 2s linear infinite !important;
    box-shadow: 0 0 20px rgba(0, 255, 213, 0.4) !important;
}

.active-rainbow .rainbow-btn {
    background: rgba(0, 255, 213, 0.12) !important;
    color: #00ffd5 !important;
}

.active-rainbow .statusBadge {
    background: #00ffd5 !important;
    color: #000 !important;
    font-weight: 900;
    box-shadow: 0 0 10px #00ffd5;
}

/* KHU VỰC NHẬP TỆP DƯỚI CÙNG */
.file-section {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
}

.file-btn {
    display: inline-block;
    width: 100%;
    padding: 14px;
    background: #181828;
    border: 1px dashed #00f0ff;
    border-radius: 12px;
    color: #00f0ff;
    font-size: 14px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.file-btn:hover { background: rgba(0, 240, 255, 0.1); }

.file-info {
    margin-top: 12px;
    background: rgba(0,0,0,0.4);
    padding: 12px;
    border-radius: 10px;
    font-size: 13px;
    word-break: break-all;
}

/* NÚT PHATTHANHIOS */
.phatthanhios-btn {
    width: 100%;
    padding: 14px;
    margin-top: 10px;
    background: linear-gradient(45deg, #ff007f, #7a00ff);
    border: none;
    border-radius: 12px;
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(255, 0, 127, 0.3);
    transition: 0.3s;
}

.phatthanhios-btn:active { transform: scale(0.97); }

/* NÚT KÝ IPA TRỰC TUYẾN */
.ipa-sign-btn {
    width: 100%;
    padding: 14px;
    margin-top: 10px;
    background: linear-gradient(45deg, #00f0ff, #00ff87);
    border: none;
    border-radius: 12px;
    color: #000;
    font-size: 15px;
    font-weight: 900;
    letter-spacing: 2px;
    cursor: pointer;
    box-shadow: 0 0 15px rgba(0, 255, 213, 0.3);
    transition: 0.3s;
}

.ipa-sign-btn:active { transform: scale(0.97); }

/* TÂM ẢO TRUNG TÂM MÀN HÌNH */
.custom-crosshair {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 36px;
    height: 36px;
    z-index: 99999;
    pointer-events: none;
    display: none;
}

/* KHU VỰC HIỂN THỊ WEB DÙNG CHUNG (TÍCH HỢP TRONG TRANG) */
.web-container {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9998;
    background: #05050a;
    display: flex;
    flex-direction: column;
}

.web-header {
    height: 50px;
    background: #10101a;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    padding: 0 15px;
}

.back-btn {
    background: rgba(255,255,255,0.1);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 5px;
}

.web-frame {
    width: 100%;
    height: calc(100% - 50px);
    border: none;
}

/* Pop-up Overlay & Bảng Code Terminal */
.modalOverlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.modalBox {
    background: #10101a;
    border: 1px solid rgba(255,255,255,0.15);
    padding: 24px 20px;
    border-radius: 22px;
    width: min(380px, 92vw);
    text-align: center;
    box-shadow: 0 0 40px rgba(0,0,0,0.8);
}

.codeBox {
    background: #050508;
    border: 1px solid rgba(0, 255, 213, 0.2);
    border-radius: 10px;
    padding: 12px;
    height: 110px;
    font-family: 'Courier New', Courier, monospace;
    font-size: 11px;
    color: #00ff87;
    text-align: left;
    overflow-y: auto;
    margin: 12px 0;
    line-height: 1.4;
}

.progressContainer {
    width: 100%;
    height: 10px;
    background: #1a1a2e;
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.progressBar {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #ff007f, #00f0ff, #00ff87);
    transition: width 0.1s linear;
}

.modalBtns {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.modalBtn {
    flex: 1;
    height: 44px;
    border: none;
    border-radius: 12px;
    font-weight: bold;
    font-size: 13px;
    cursor: pointer;
    transition: 0.2s;
}

.btnYes { background: linear-gradient(45deg, #00ff87, #00f0ff); color: #000; }
.btnNo { background: #222230; color: #fff; }

.hidden { display: none !important; }

.footer {
    margin-top: 25px;
    color: #555566;
    font-size: 10px;
    letter-spacing: 2px;
    text-align: center;
}

.logout-link {
    color: #ff007f;
    text-decoration: underline;
    cursor: pointer;
    font-size: 11px;
    margin-top: 8px;
    display: inline-block;
}
</style>
</head>

<body>

<!-- THẺ PHÁT NHẠC NỀN -->
