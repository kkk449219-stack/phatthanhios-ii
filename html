<script>
/* THAY ĐỔI TÊN FILE NHẠC CỦA BẠN TẠI ĐÂY */
const AUDIO_SRC = "nhac.mp3"; 

/* MẬT KHẨU / KEY ĐÚNG */
const SECRET_KEY = "phatthanhios";

/* LỆNH MÔ PHỎNG */
const codeLines = [
    "> Initializing memory buffer...",
    "> Injecting system offsets...",
    "> Verifying security bypass...",
    "> Patching game engine values...",
    "> Overriding recoil variables...",
    "> Aligning crosshair coordinates...",
    "> Optimization complete 100%!"
];

let bgAudio = null;

window.onload = function() {
    bgAudio = document.getElementById("bgMusic");
    if (bgAudio) {
        bgAudio.src = AUDIO_SRC;
    }

    setTimeout(() => {
        playAudio();
    }, 5000);

    const savedKey = localStorage.getItem("vip_key_activated");
    if (savedKey === SECRET_KEY) {
        document.getElementById("keyScreen").classList.add("hidden");
    }
};

function playAudio() {
    if (bgAudio && bgAudio.paused) {
        bgAudio.play().catch(() => {
            const startAudioOnInteraction = () => {
                bgAudio.play();
                document.removeEventListener("click", startAudioOnInteraction);
                document.removeEventListener("touchstart", startAudioOnInteraction);
            };
            document.addEventListener("click", startAudioOnInteraction);
            document.addEventListener("touchstart", startAudioOnInteraction);
        });
    }
}

function checkKey() {
    const inputVal = document.getElementById("keyInput").value.trim();
    const errorDiv = document.getElementById("keyError");

    if (inputVal === SECRET_KEY) {
        localStorage.setItem("vip_key_activated", SECRET_KEY);
        document.getElementById("keyScreen").classList.add("hidden");
        errorDiv.textContent = "";
    } else {
        errorDiv.textContent = "❌ Key không chính xác, vui lòng thử lại!";
        if ("vibrate" in navigator) {
            navigator.vibrate([100, 50, 100]);
        }
    }
}

function logoutKey() {
    localStorage.removeItem("vip_key_activated");
    document.getElementById("keyInput").value = "";
    document.getElementById("keyError").textContent = "";
    document.getElementById("keyScreen").classList.remove("hidden");
}

function btnAction() {
    playAudio();

    try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(900, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(450, audioCtx.currentTime + 0.07);

        gain.gain.setValueAtTime(0.3, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.07);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.07);
    } catch(e) {}

    if ("vibrate" in navigator) {
        navigator.vibrate(35);
    }
}

let vipStates = { aimlook: false, aimbot: false, nheTam: false, fixLo: false, tamAo: false, aimbooy: false, aimneck: false };
let currentVipType = null;

function triggerVipProcess(name, type) {
    currentVipType = type;
    const isTurningOn = !vipStates[type];

    if (!isTurningOn) {
        toggleFeatureState(type, false);
        return;
    }

    document.getElementById("progressTitle").textContent = "KÍCH HOẠT " + name;
    document.getElementById("progressBar").style.width = "0%";
    document.getElementById("progressPercent").textContent = "0%";
    document.getElementById("codeConsole").innerHTML = "";
    document.getElementById("progressCloseBtn").classList.add("hidden");
    document.getElementById("progressModal").classList.remove("hidden");

    let startTime = Date.now();
    const duration = 5000;

    const interval = setInterval(() => {
        let elapsed = Date.now() - startTime;
        let progress = Math.min(100, Math.floor((elapsed / duration) * 100));

        let lineIndex = Math.floor((progress / 100) * codeLines.length);
        if (codeLines[lineIndex] && !document.getElementById("codeConsole").innerHTML.includes(codeLines[lineIndex])) {
            document.getElementById("codeConsole").innerHTML += codeLines[lineIndex] + "<br>";
            document.getElementById("codeConsole").scrollTop = document.getElementById("codeConsole").scrollHeight;
        }

        document.getElementById("progressBar").style.width = progress + "%";
        document.getElementById("progressPercent").textContent = progress + "%";

        if (progress >= 100) {
            clearInterval(interval);
            document.getElementById("progressCloseBtn").classList.remove("hidden");
        }
    }, 50);
}

function closeProgressModal() {
    document.getElementById("progressModal").classList.add("hidden");
    if (currentVipType) {
        toggleFeatureState(currentVipType, true);
    }
}

function toggleFeatureState(type, state) {
    vipStates[type] = state;
    const box = document.getElementById(type + "Box");
    const status = document.getElementById(type + "Status");

    if (state) {
        box.classList.add("active-rainbow");
        status.textContent = "ON";
        if (type === "tamAo") {
            document.getElementById("crosshair").style.display = "block";
        }
    } else {
        box.classList.remove("active-rainbow");
        status.textContent = "OFF";
        if (type === "tamAo") {
            document.getElementById("crosshair").style.display = "none";
        }
    }
}

