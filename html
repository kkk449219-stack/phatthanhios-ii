let selectedFileName = "";

function handleFileSelect(event) {
    const file = event.target.files[0];
    const displayArea = document.getElementById("fileDisplayArea");
    const nameText = document.getElementById("fileNameText");
    const statusText = document.getElementById("fileStatusText");
    const applyBtn = document.getElementById("applyFileBtn");

    if (!file) return;

    selectedFileName = file.name;
    displayArea.classList.remove("hidden");
    nameText.textContent = "📄 " + selectedFileName;

    if (selectedFileName.toLowerCase().includes("freefire")) {
        statusText.textContent = "✓ Tệp hợp lệ! Sẵn sàng áp dụng.";
        statusText.style.color = "#00ff87";
        applyBtn.classList.remove("hidden");
    } else {
        statusText.textContent = "❌ File không áp dụng được! Tên tệp phải chứa chữ 'freefire'.";
        statusText.style.color = "#ff3366";
        applyBtn.classList.add("hidden");
        if ("vibrate" in navigator) {
            navigator.vibrate([100, 50, 100]);
        }
    }
}

